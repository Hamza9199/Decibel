{
  "name": "decibel",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Decibel desktop app",
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.decibel.desktop",
    "productName": "Decibel",
    "directories": {
      "output": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "Decibel-Setup-${version}.${ext}",
      "executableName": "Decibel"
    },
    "nsis": {
      "shortcutName": "Decibel",
      "uninstallDisplayName": "Decibel"
    },
    "files": [
      "main.js",
      "package.json",
      "assets/**/*",
      "dist/**/*",
      "preload.js",
      ".evn"
    ]
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "discord-rpc-revamp": "^2.0.4",
    "dotenv": "^17.2.1",
    "express": "^5.1.0"
  }
}
