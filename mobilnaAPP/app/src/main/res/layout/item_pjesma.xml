<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp"
    android:layout_height="210dp"
    card_view:cardCornerRadius="18dp"
    card_view:cardElevation="6dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="8dp"
    android:background="@color/spotify_card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/slikaPjesme"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background"
            android:background="@drawable/spotify_album_bg"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/nazivPjesme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Naziv pjesme"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:layout_marginTop="12dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:id="@+id/opisPjesme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Opis pjesme"
            android:textSize="13sp"
            android:textColor="@color/spotify_gray"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
