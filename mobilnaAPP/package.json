{
  "name": "mobilnaapp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "cross-env NODE_OPTIONS=--no-deprecation EAS_SKIP_AUTO_FINGERPRINT=1 eas build --platform android --profile preview",
    "build:web": "npx expo export --platform web",
    "build:android:prod": "cross-env NODE_OPTIONS=--no-deprecation EAS_SKIP_AUTO_FINGERPRINT=1 eas build --platform android --profile production",
    "build:ios": "cross-env NODE_OPTIONS=--no-deprecation EAS_SKIP_AUTO_FINGERPRINT=1 eas build --platform ios --profile preview",
    "build:ios:prod": "cross-env NODE_OPTIONS=--no-deprecation EAS_SKIP_AUTO_FINGERPRINT=1 eas build --platform ios --profile production",
    "build:clear": "cross-env NODE_OPTIONS=--no-deprecation EAS_SKIP_AUTO_FINGERPRINT=1 eas build --platform android --profile preview --clear-cache",
    "build:android:win": "set NODE_OPTIONS=--no-deprecation && set EAS_SKIP_AUTO_FINGERPRINT=1 && eas build --platform android --profile preview",
    "prebuild": "expo prebuild",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.1.8",
    "@miblanchard/react-native-slider": "^2.6.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "^5.83.0",
    "axios": "^1.10.0",
    "dotenv": "^16.0.0",
    "expo": "^57.0.11",
    "expo-asset": "^57.0.9",
    "expo-audio": "^57.0.3",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.9",
    "expo-checkbox": "~57.0.0",
    "expo-constants": "~57.0.9",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-image-picker": "~57.0.8",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-localization": "~57.0.1",
    "expo-media-library": "~57.0.3",
    "expo-media-session": "^0.0.0",
    "expo-navigation-bar": "~57.0.2",
    "expo-notifications": "~57.0.9",
    "expo-router": "~57.0.11",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-video": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "i18next": "^23.7.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^13.5.0",
    "react-native": "0.86.2",
    "react-native-calendars": "^1.1313.0",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-localize": "^3.5.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.3",
    "victory-native": "^41.17.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.18",
    "cross-env": "^7.0.3",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
