{
  "name": "mobilnaapp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "cross-env NODE_OPTIONS=--no-deprecation EAS_SKIP_AUTO_FINGERPRINT=1 eas build --platform android --profile preview",
    "build:web": "npx expo export --platform web",
    "build:android:prod": "cross-env NODE_OPTIONS=--no-deprecation EAS_SKIP_AUTO_FINGERPRINT=1 eas build --platform android --profile production",
    "build:ios": "cross-env NODE_OPTIONS=--no-deprecation EAS_SKIP_AUTO_FINGERPRINT=1 eas build --platform ios --profile preview",
    "build:ios:prod": "cross-env NODE_OPTIONS=--no-deprecation EAS_SKIP_AUTO_FINGERPRINT=1 eas build --platform ios --profile production",
    "build:clear": "cross-env NODE_OPTIONS=--no-deprecation EAS_SKIP_AUTO_FINGERPRINT=1 eas build --platform android --profile preview --clear-cache",
    "build:android:win": "set NODE_OPTIONS=--no-deprecation && set EAS_SKIP_AUTO_FINGERPRINT=1 && eas build --platform android --profile preview",
    "prebuild": "expo prebuild",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@gorhom/bottom-sheet": "^5.1.8",
    "@miblanchard/react-native-slider": "^2.6.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@shopify/react-native-skia": "^2.1.1",
    "@tanstack/react-query": "^5.83.0",
    "axios": "^1.10.0",
    "dotenv": "^16.0.0",
    "expo": "~53.0.20",
    "expo-audio": "^0.4.8",
    "expo-av": "^15.1.7",
    "expo-blur": "~14.1.5",
    "expo-build-properties": "^0.14.8",
    "expo-checkbox": "^4.1.4",
    "expo-constants": "~17.1.7",
    "expo-device": "^7.1.4",
    "expo-document-picker": "~13.1.6",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.4.0",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "^14.1.5",
    "expo-linking": "~7.1.7",
    "expo-localization": "~16.1.6",
    "expo-media-library": "^17.1.7",
    "expo-navigation-bar": "~4.2.7",
    "expo-notifications": "^0.31.4",
    "expo-router": "~5.1.4",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "~5.0.10",
    "expo-video": "^2.2.2",
    "expo-web-browser": "~14.2.0",
    "i18next": "^23.7.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-i18next": "^13.5.0",
    "react-native": "0.79.5",
    "react-native-calendars": "^1.1313.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-localize": "^3.5.1",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "~0.20.0",
    "react-native-webview": "13.13.5",
    "victory-native": "^41.17.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/node": "^20.0.0",
    "@types/react": "~19.0.10",
    "cross-env": "^7.0.3",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "typescript": "~5.8.3"
  },
  "private": true
}
